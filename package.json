{
  "name": "pypilot-vscode",
  "displayName": "PyPilot",
  "description": "Sets up Python environments, resolves version and hardware compatibility without external AI or API keys.",
  "version": "1.2.1",
  "license": "Apache-2.0",
  "publisher": "AbdullahMasood-005",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "python",
    "virtualenv",
    "uv",
    "pip",
    "mediapipe",
    "pytorch",
    "cuda",
    "environment"
  ],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/pypilot-dev/pypilot-vscode"
  },
  "bugs": {
    "url": "https://github.com/pypilot-dev/pypilot-vscode/issues"
  },
  "homepage": "https://github.com/pypilot-dev/pypilot-vscode#readme",
  "activationEvents": [
    "workspaceContains:**/*.py",
    "workspaceContains:requirements.txt",
    "workspaceContains:pyproject.toml",
    "workspaceContains:pixi.toml",
    "workspaceContains:environment.yml",
    "onNotebook:jupyter-notebook"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pypilot.setup",
        "title": "PyPilot: Set Up Environment",
        "icon": "$(rocket)"
      },
      {
        "command": "pypilot.doctor",
        "title": "PyPilot: Doctor: Show Environment Report",
        "icon": "$(search)"
      },
      {
        "command": "pypilot.fixPython",
        "title": "PyPilot: Fix Python Version",
        "icon": "$(tools)"
      },
      {
        "command": "pypilot.fixCuda",
        "title": "PyPilot: Fix CUDA / PyTorch Build",
        "icon": "$(circuit-board)"
      },
      {
        "command": "pypilot.check",
        "title": "PyPilot: Check Package Compatibility…",
        "icon": "$(checklist)"
      },
      {
        "command": "pypilot.install",
        "title": "PyPilot: Install Package…",
        "icon": "$(package)"
      },
      {
        "command": "pypilot.updateData",
        "title": "PyPilot: Update Bundled Data Tables",
        "icon": "$(cloud-download)"
      },
      {
        "command": "pypilot.migrateConda",
        "title": "PyPilot: Migrate Conda environment.yml to pyproject.toml",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "pypilot.openReport",
        "title": "PyPilot: Open Environment Report Panel",
        "icon": "$(preview)"
      },
      {
        "command": "pypilot.installUv",
        "title": "PyPilot: Install uv Globally",
        "icon": "$(cloud-download)"
      },
      {
        "command": "pypilot.installPixiCli",
        "title": "PyPilot: Install pixi",
        "icon": "$(cloud-download)"
      },
      {
        "command": "pypilot.updateHelper",
        "title": "PyPilot: Check for Helper Updates",
        "icon": "$(sync)"
      },
      {
        "command": "pypilot.useProjectVenv",
        "title": "PyPilot: Use Project Environment (.venv / pixi)",
        "icon": "$(symbol-namespace)"
      }
    ],
    "configuration": {
      "title": "PyPilot",
      "properties": {
        "pypilot.packageManager": {
          "type": "string",
          "enum": ["auto", "uv", "uv-pip", "pip", "pixi"],
          "enumDescriptions": [
            "Auto (default): Uses uv if installed on system PATH, prompts to install if missing, or falls back to pip. pixi projects (pixi.toml, or [tool.pixi.workspace] in pyproject.toml) always use pixi.",
            "Use uv project mode (pyproject.toml + uv.lock).",
            "Use uv-accelerated pip-compatible mode (requirements.txt only via uv venv and uv pip).",
            "Use standard pip + python -m venv. Never touches uv.",
            "Use pixi: the environment lives in .pixi/envs/<name> (see pypilot.pixiEnvironment), installs go through `pixi add --pypi`, and PyPilot never creates a .venv or edits pixi.lock."
          ],
          "default": "auto",
          "description": "Package manager for environment creation and installs.",
          "scope": "resource"
        },
        "pypilot.notifications": {
          "type": "string",
          "enum": ["all", "problems-only", "off"],
          "enumDescriptions": [
            "Toast for every finding, including informational notes.",
            "Only toast for warnings and errors.",
            "Suppress all automatic notifications."
          ],
          "default": "problems-only",
          "description": "Controls when PyPilot shows automatic notifications on workspace open.",
          "scope": "resource"
        },
        "pypilot.autoCheckOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan the workspace when it is first opened.",
          "scope": "resource"
        },
        "pypilot.autoSelectVenv": {
          "type": "boolean",
          "default": true,
          "description": "Make the workspace's .venv (in pixi projects: the pixi environment named by pypilot.pixiEnvironment, .pixi/envs/<name>) the active Python interpreter (and so the recommended notebook kernel) when it is created or changed, and on startup when no interpreter inside the workspace is selected. Requires the Python extension. The \"PyPilot: Use Project Environment\" command works regardless of this setting.",
          "scope": "resource"
        },
        "pypilot.pixiEnvironment": {
          "type": "string",
          "default": "default",
          "pattern": "^[a-z0-9-]+$",
          "patternErrorMessage": "pixi environment names use lowercase letters, digits and dashes.",
          "markdownDescription": "Which pixi environment PyPilot and the interpreter selection use in multi-environment pixi projects (the `[environments]` table of `pixi.toml`). The interpreter is `.pixi/envs/<name>`; install it with `pixi install -e <name>`. Ignored outside pixi projects.",
          "scope": "resource"
        },
        "pypilot.dataRefreshDays": {
          "type": "number",
          "default": 7,
          "minimum": 0,
          "description": "How often (in days) to refresh bundled tables. 0 means fully offline.",
          "scope": "resource"
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "pypilot",
        "required": ["task"],
        "properties": {
          "task": {
            "type": "string",
            "description": "The pypilot task to run.",
            "enum": ["setup", "doctor", "fix python", "fix cuda", "update-data", "migrate-conda"]
          },
          "package": {
            "type": "string",
            "description": "Package name (for install / check tasks)."
          }
        }
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun run build.ts",
    "watch": "bun run build.ts --watch",
    "lint": "bunx @biomejs/biome check src",
    "package": "bun run build --production && bunx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.85.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.24.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
